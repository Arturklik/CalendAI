# Database
POSTGRES_USER=calendai
POSTGRES_PASSWORD=calendai
POSTGRES_DB=calendai

# Security
JWT_SECRET_KEY=change-this-secret-key-in-production

# AI Recognition Provider (DeepSeek / OpenAI / OpenRouter)
# Add your provider API key to enable timetable recognition.
CALENDAI_API_KEY=
CALENDAI_BASE_URL=https://api.deepseek.com
CALENDAI_MODEL=deepseek-chat
# Optional; leave blank to select a provider-compatible default automatically.
CALENDAI_FALLBACK_MODEL=

# Telegram Bot (leave blank to disable the bot)
TELEGRAM_BOT_TOKEN=
