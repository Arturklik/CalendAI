# API-ключ OpenAI-совместимого провайдера (обязательно).
CALENDAI_API_KEY=sk-...

# Базовый URL API:
#   OpenAI      https://api.openai.com/v1
#   DeepSeek    https://api.deepseek.com
#   OpenRouter  https://openrouter.ai/api/v1
CALENDAI_BASE_URL=https://api.openai.com/v1

# Модель. Для распознавания изображений нужна vision-модель.
CALENDAI_MODEL=gpt-4o-mini
