# --- Общее ---
DEBUG=false

# --- База данных (PostgreSQL + asyncpg) ---
DATABASE_URL=postgresql+asyncpg://calendai:calendai@localhost:5432/calendai

# --- JWT (обязательно заменить в продакшене: openssl rand -hex 32) ---
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
TELEGRAM_LINK_TOKEN_EXPIRE_MINUTES=15

# --- AI (OpenAI-совместимый провайдер для ai_module) ---
# OpenAI:      CALENDAI_BASE_URL=https://api.openai.com/v1
# DeepSeek:    CALENDAI_BASE_URL=https://api.deepseek.com
# OpenRouter:  CALENDAI_BASE_URL=https://openrouter.ai/api/v1
CALENDAI_API_KEY=sk-...
CALENDAI_BASE_URL=https://api.openai.com/v1
CALENDAI_MODEL=gpt-4o-mini

# --- Telegram-бот ---
TELEGRAM_BOT_TOKEN=
BOT_DEFAULT_TIMEZONE=+07:00
WHISPER_MODEL=whisper-1
BOT_MODE=polling
# Для webhook-режима:
# BOT_MODE=webhook
# WEBHOOK_URL=https://your-domain.example
# WEBHOOK_SECRET=random-secret-string
